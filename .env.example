# Copy this file to .env and fill in your values
# Never commit .env to GitHub!

# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Check https://aistudio.google.com for current free model name
# Examples: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Create any secret code for teacher access to /api/generate
# Use a strong random string
TEACHER_CODE=your_teacher_code_here